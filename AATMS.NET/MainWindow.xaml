<Window x:Class="AATMS.NET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Advanced Automatic Traffic Monitoring System" Height="600" Width="1000"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="AATMS - Advanced Automatic Traffic Monitoring System" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                <TextBlock Text="Select video and ONNX model files to begin" 
                         Style="{StaticResource MaterialDesignBody1TextBlock}"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Video File" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <DockPanel Margin="0,8">
                            <Button DockPanel.Dock="Right" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="SelectVideo_Click"
                                    Margin="8,0,0,0">
                                Browse
                            </Button>
                            <TextBox x:Name="VideoPathTextBox" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ONNX Model File" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <DockPanel Margin="0,8">
                            <Button DockPanel.Dock="Right" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="SelectModel_Click"
                                    Margin="8,0,0,0">
                                Browse
                            </Button>
                            <TextBox x:Name="ModelPathTextBox" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <CheckBox x:Name="FrameSkipCheckBox" 
                                 Content="Skip frames for faster processing"
                                 Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <StackPanel Grid.Column="1" Width="200">
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="StartProcessing_Click"
                        Margin="0,0,0,8">
                    Start Processing
                </Button>
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="SelectOutputDirectory_Click">
                    Select Output Directory
                </Button>
            </StackPanel>
        </Grid>

        <materialDesign:Card Grid.Row="2" Margin="16" Padding="16">
            <TextBlock x:Name="StatusTextBlock" 
                      Text="Ready to process"
                      Style="{StaticResource MaterialDesignBody1TextBlock}"/>
        </materialDesign:Card>
    </Grid>
</Window> 